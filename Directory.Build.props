<Project>

  <!--
    Single source of truth for the product version.

    Bump it here and nowhere else — everything downstream is generated:
      - the assembly version attributes, by GenerateVersionAssemblyInfo
      - <Identity Version> in source.extension.vsixmanifest, which holds the token
        |%CurrentProject%;GetVsixVersion| and is resolved at build time
    Both targets live in Directory.Build.targets.

    Worth keeping that way: the Marketplace rejects an upload whose version was already
    published, and it only says so after you have built and tagged.
  -->
  <PropertyGroup>
    <!--
      The whole version, suffix and all — this is what the release tag must equal, and what
      AssemblyInformationalVersion carries so a preview build can say it is one at runtime. Ship a
      stable release by dropping the suffix.
    -->
    <Version>1.8.0</Version>

    <!--
      The same version without the suffix, for the places that take digits only: the VSIX Identity
      Version and AssemblyVersion. Derived rather than typed, so the two cannot drift.
    -->
    <VsixVersion>$(Version.Split('-')[0])</VsixVersion>
  </PropertyGroup>

  <!--
    Package-level metadata (PackageLicenseExpression, RepositoryUrl, …) is deliberately absent:
    nothing here ships to NuGet. The VSIX equivalents — licence, repo link, description, tags —
    live in source.extension.vsixmanifest, which is what the Marketplace reads. Company, Product
    and Copyright stay in the legacy AssemblyInfo.cs; only the version attributes are generated
    (GenerateVersionAssemblyInfo), because those need to agree with Version.
  -->
  <PropertyGroup>
    <AssemblyVersion>$(VsixVersion).0</AssemblyVersion>
    <FileVersion>$(VsixVersion).0</FileVersion>
  </PropertyGroup>

</Project>
