---
/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: GPL-3.0-only
 *
 * Starlight's Card, for the icons its set does not have: Card takes only a built-in icon name,
 * and there is no bug among them. Markup and styles are Card's own, so the two sit in the same
 * CardGrid and the colour cycle carries across them. Use Card whenever the set has the icon.
 */
interface Props {
  icon: keyof typeof icons;
  title: string;
}

// Drawn on Starlight's 24x24 grid, as outlines of the same weight as its icons.
const icons = {
  bug:
    '<rect x="7" y="8" width="10" height="12" rx="5"/>' +
    '<path d="M12 12.5V20M8.5 8.6a3.5 3.5 0 0 1 7 0M8.6 3.5l1.6 2.4M15.4 3.5l-1.6 2.4' +
    'M7 12H3.5M7 15.5H3M7.8 18.6l-2.6 1.9M17 12h3.5M17 15.5h4M16.2 18.6l2.6 1.9"/>',
};

const { icon, title } = Astro.props;
---

<article class="card sl-flex">
  <p class="title sl-flex">
    <svg
      aria-hidden="true"
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={icons[icon]}
    />
    <span>{title}</span>
  </p>
  <div class="body"><slot /></div>
</article>

<style>
  @layer starlight.components {
    .card {
      --sl-card-border: var(--sl-color-purple);
      --sl-card-bg: var(--sl-color-purple-low);
      border: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-black);
      padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
      flex-direction: column;
      gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    }
    .card:nth-child(4n + 1) {
      --sl-card-border: var(--sl-color-orange);
      --sl-card-bg: var(--sl-color-orange-low);
    }
    .card:nth-child(4n + 3) {
      --sl-card-border: var(--sl-color-green);
      --sl-card-bg: var(--sl-color-green-low);
    }
    .card:nth-child(4n + 4) {
      --sl-card-border: var(--sl-color-red);
      --sl-card-bg: var(--sl-color-red-low);
    }
    .card:nth-child(4n + 5) {
      --sl-card-border: var(--sl-color-blue);
      --sl-card-bg: var(--sl-color-blue-low);
    }
    .title {
      font-weight: 600;
      font-size: var(--sl-text-h4);
      color: var(--sl-color-white);
      line-height: var(--sl-line-height-headings);
      gap: 1rem;
      align-items: center;
    }
    .card .icon {
      font-size: 1.333em;
      width: 1em;
      height: 1em;
      border: 1px solid var(--sl-card-border);
      background-color: var(--sl-card-bg);
      padding: 0.2em;
      border-radius: 0.25rem;
      flex-shrink: 0;
    }
    .card .body {
      margin: 0;
      font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
    }
  }
</style>
