<!--
  The status bar item's popup. It opens in a window of its own, outside the VS tree, so Themes.UseVsTheme
  can't reach it: every surface here is bound to EnvironmentColors explicitly, the drop-down keys the
  themed context menus use too (Themes/MenuStyles.xaml).
-->
<UserControl x:Class="Corsinvest.VisualStudio.Agents.Core.Usage.UsagePopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:controls="clr-namespace:Corsinvest.VisualStudio.Agents.Core.Controls"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownTextBrushKey}}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Corsinvest.VisualStudio.Agents;component/Themes/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
      </Style>

      <Style x:Key="Link" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ControlLinkTextBrushKey}}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ControlLinkTextHoverBrushKey}}" />
            <Setter Property="TextDecorations" Value="Underline" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Accent while comfortable, the same amber and red as the status bar item past its thresholds. -->
      <Style x:Key="BarFill" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource {x:Static vsui:EnvironmentColors.MainWindowActiveIconDefaultBrushKey}}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Level}" Value="Warning">
            <Setter Property="Fill" Value="{DynamicResource {x:Static vsui:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="Critical">
            <Setter Property="Fill" Value="{DynamicResource {x:Static vsui:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Width="320" Padding="14,12,14,10" BorderThickness="1"
          Background="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBackgroundBeginBrushKey}}"
          BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBorderBrushKey}}">
    <StackPanel>
      <!-- Whose usage, on which plan. -->
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="{StaticResource MascotImage}" Width="20" Height="20"
               Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock x:Name="PlanText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock x:Name="ProfileText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.MainWindowActiveIconDefaultBrushKey}}" />
      </DockPanel>

      <controls:CvLoadingOverlay x:Name="LoadingPanel" Message="Fetching usage…" Margin="0,18,0,10" Visibility="Collapsed" />
      <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8" Visibility="Collapsed" />

      <!-- Every window the CLI reported, session first. -->
      <ItemsControl x:Name="WindowsList" Margin="0,4,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,8,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <Grid Height="4" Margin="0,4,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding FilledWidth}" />
                  <ColumnDefinition Width="{Binding EmptyWidth}" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="2" Opacity="0.2"
                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Rectangle Grid.Column="0" Style="{StaticResource BarFill}" />
              </Grid>
              <TextBlock Text="{Binding ResetText}" Style="{StaticResource Caption}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Collapsed, so an email isn't on screen every time the popup opens. -->
      <controls:CvExpander x:Name="AccountExpander" Header="Account" Margin="0,12,0,0"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownTextBrushKey}}">
        <ItemsControl x:Name="AccountList" Margin="0,2,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource Caption}"
                           Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Value}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:CvExpander>

      <Border Height="1" Margin="0,10,0,6"
              Background="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBorderBrushKey}}" />
      <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                 Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
      <WrapPanel Margin="0,6,0,0">
        <TextBlock Margin="0,0,14,0">
          <Hyperlink x:Name="RefreshLink" Style="{StaticResource Link}" Click="OnRefreshClick">Refresh</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,0,14,0">
          <Hyperlink Style="{StaticResource Link}" Click="OnOpenUsageClick">Open Usage</Hyperlink>
        </TextBlock>
        <!-- Only meaningful for a first-party claude.ai login. -->
        <TextBlock x:Name="ManageLinkHost">
          <Hyperlink Style="{StaticResource Link}" NavigateUri="https://claude.ai/settings/usage"
                     RequestNavigate="OnLinkNavigate">Manage on claude.ai</Hyperlink>
        </TextBlock>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
