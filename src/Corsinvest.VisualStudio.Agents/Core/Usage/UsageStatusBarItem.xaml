<UserControl x:Class="Corsinvest.VisualStudio.Agents.Core.Usage.UsageStatusBarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Cursor="Hand"
             ToolTipService.ShowDuration="60000"
             AutomationProperties.Name="Claude plan usage">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Corsinvest.VisualStudio.Agents;component/Themes/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <!-- Hover / open highlight in the bar's own text colour, faint: it reads in every state the status bar
         goes through (idle, building, debugging) without a brush per state. Opacity is set from code. -->
    <Border x:Name="Highlight" Opacity="0"
            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <StackPanel x:Name="ContentPanel" Orientation="Horizontal" Margin="7,0,8,0">
      <Image Source="{StaticResource MascotImage}" Width="16" Height="16" Margin="0,0,5,0"
             VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <!-- Margin, not a trailing space in the text: the name is dropped when a pane has the focus,
           and a collapsed TextBlock must not leave the gap behind. -->
      <TextBlock x:Name="ProfileText" VerticalAlignment="Center" Margin="0,0,4,0" />
      <!-- One cell per figure, each with its bar underneath; built in code. -->
      <StackPanel x:Name="SegmentsPanel" Orientation="Horizontal" />
    </StackPanel>
  </Grid>
</UserControl>
