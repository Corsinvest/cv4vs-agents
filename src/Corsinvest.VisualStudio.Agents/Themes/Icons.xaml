<!--
  The mascot as vector art, traced from Resources/plugin-logo.png on the same 500×500 grid, so it stays
  sharp at any size and DPI where the PNG blurs at 16px. Merge the dictionary to use it:

    <ResourceDictionary Source="/Corsinvest.VisualStudio.Agents;component/Themes/Icons.xaml" />

  MascotImage is the full-colour logo, for an Image. MascotGeometry is the bare silhouette (eyes cut out),
  for anything that needs a single-colour version. ChatGlyphImage is the chat pane's corner glyph on its
  tab icon. Helpers/ToolWindowIcons.cs hands MascotImage and ChatGlyphImage to Visual Studio's image
  library by key, so renaming either leaves the tool window tabs without it.

  The mascot is Resources/plugin-logo.svg in XAML, layer for layer and number for number: that file is
  the vector source, so a change there is a change here. Its numbers are fitted to the PNG's pixels by
  least squares rather than drawn, which is why the brushes are in absolute units on that grid and only
  line up on a geometry drawn there.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

  <!-- Body (round top corners, tighter bottom ones), the arms as one bar through it, four legs, and the
       eyes excluded. -->
  <CombinedGeometry x:Key="MascotGeometry" GeometryCombineMode="Exclude" po:Freeze="True">
    <CombinedGeometry.Geometry1>
      <GeometryGroup FillRule="Nonzero">
        <PathGeometry Figures="M 83,100 H 419 A 19,19 0 0 1 438,119 V 344 A 10,10 0 0 1 428,354 H 73 A 10,10 0 0 1 63,344 V 120 A 20,20 0 0 1 83,100 Z" />
        <RectangleGeometry Rect="6,228,488,64" RadiusX="10" RadiusY="10" />
        <RectangleGeometry Rect="95,340,31,76" RadiusX="8" RadiusY="8" />
        <RectangleGeometry Rect="157,340,32,76" RadiusX="8" RadiusY="8" />
        <RectangleGeometry Rect="311,340,32,76" RadiusX="8" RadiusY="8" />
        <RectangleGeometry Rect="374,340,31,76" RadiusX="8" RadiusY="8" />
      </GeometryGroup>
    </CombinedGeometry.Geometry1>
    <CombinedGeometry.Geometry2>
      <GeometryGroup>
        <RectangleGeometry Rect="126,167,31,61" />
        <RectangleGeometry Rect="343,167,31,61" />
      </GeometryGroup>
    </CombinedGeometry.Geometry2>
  </CombinedGeometry>

  <!-- The lit surface, top to bottom. -->
  <LinearGradientBrush x:Key="MascotBrush" MappingMode="Absolute" StartPoint="11.5,108.9" EndPoint="47.3,449.9" po:Freeze="True">
    <GradientStop Offset="0" Color="#F898D6" />
    <GradientStop Offset="0.2" Color="#E05EF2" />
    <GradientStop Offset="0.4" Color="#BD58EF" />
    <GradientStop Offset="0.6" Color="#934DEE" />
    <GradientStop Offset="0.8" Color="#7049EA" />
    <GradientStop Offset="1" Color="#604BE0" />
  </LinearGradientBrush>

  <!-- The left arm and the body under the fold, lit from the top-left where the rest is lit from above. -->
  <LinearGradientBrush x:Key="MascotLowerBrush" MappingMode="Absolute" StartPoint="312.3,429.9" EndPoint="113.6,156.4" po:Freeze="True">
    <GradientStop Offset="0" Color="#654AE4" />
    <GradientStop Offset="0.2" Color="#7E48EC" />
    <GradientStop Offset="0.4" Color="#9047ED" />
    <GradientStop Offset="0.6" Color="#9544ED" />
    <GradientStop Offset="0.8" Color="#B34FF0" />
    <GradientStop Offset="1" Color="#F479E8" />
  </LinearGradientBrush>

  <!-- The dark fold beside the left eye. -->
  <LinearGradientBrush x:Key="MascotFoldBrush" MappingMode="Absolute" StartPoint="-3.5,98.9" EndPoint="-7.8,224.5" po:Freeze="True">
    <GradientStop Offset="0" Color="#5828A2" />
    <GradientStop Offset="0.2" Color="#5523AD" />
    <GradientStop Offset="0.4" Color="#682EBF" />
    <GradientStop Offset="0.6" Color="#6F32C8" />
    <GradientStop Offset="0.8" Color="#7A37D3" />
    <GradientStop Offset="1" Color="#813AD9" />
  </LinearGradientBrush>

  <!-- The fold's band below the eye: darkest along its upper edge (this brush, across the band), and
       dissolving down its length (MascotBandFade, along it). -->
  <LinearGradientBrush x:Key="MascotBandBrush" MappingMode="Absolute" StartPoint="-81.5,81.5" EndPoint="-35.5,35.5" po:Freeze="True">
    <GradientStop Offset="0" Color="#853CE2" />
    <GradientStop Offset="0.2" Color="#7F3CDE" />
    <GradientStop Offset="0.4" Color="#763BD9" />
    <GradientStop Offset="0.6" Color="#6D38D2" />
    <GradientStop Offset="0.8" Color="#5E33C5" />
    <GradientStop Offset="1" Color="#5C31BB" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MascotBandFade" MappingMode="Absolute" StartPoint="147,147" EndPoint="320,320" po:Freeze="True">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="0.25" Color="#D8FFFFFF" />
    <GradientStop Offset="0.5" Color="#90FFFFFF" />
    <GradientStop Offset="0.75" Color="#54FFFFFF" />
    <GradientStop Offset="1" Color="#02FFFFFF" />
  </LinearGradientBrush>

  <!-- The crease from the right eye to the arm: a shadow over whatever is under it, so alpha only. -->
  <LinearGradientBrush x:Key="MascotCreaseBrush" MappingMode="Absolute" StartPoint="-14.9,11.6" EndPoint="129.6,-101.2" po:Freeze="True">
    <GradientStop Offset="0" Color="#00280F8C" />
    <GradientStop Offset="0.6" Color="#04280F8C" />
    <GradientStop Offset="0.8" Color="#13280F8C" />
    <GradientStop Offset="1" Color="#54280F8C" />
  </LinearGradientBrush>

  <DrawingImage x:Key="MascotImage" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- An empty 500×500 frame, so the image has the logo's square proportions and centres alike. -->
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,500,500" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- White eyes, as in the logo: through the cut-outs a dark status bar would otherwise show. -->
        <GeometryDrawing Brush="White">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="126,167,31,61" />
              <RectangleGeometry Rect="343,167,31,61" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- The shading layers are plain polygons running past the edge: the clip is what shapes them. -->
        <DrawingGroup ClipGeometry="{StaticResource MascotGeometry}">
          <GeometryDrawing Brush="{StaticResource MascotBrush}" Geometry="{StaticResource MascotGeometry}" />
          <GeometryDrawing Brush="{StaticResource MascotLowerBrush}" Geometry="M 0,228 H 157 L 429,500 H 0 Z" />
          <DrawingGroup OpacityMask="{StaticResource MascotBandFade}">
            <GeometryDrawing Brush="{StaticResource MascotBandBrush}" Geometry="M 65,228 H 157 L 429,500 H 337 Z" />
          </DrawingGroup>
          <GeometryDrawing Brush="{StaticResource MascotFoldBrush}"
                           Geometry="M 0,100 H 76 Q 84,101 93.5,111 L 149.5,167 H 126 V 228 H 0 Z" />
          <GeometryDrawing Brush="{StaticResource MascotCreaseBrush}" Geometry="M 250,228 H 374 L 500,354 V 500 H 250 Z" />
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- The chat pane's glyph, drawn at 9/16 of the tab icon over the mascot's bottom-right corner. A solid
       bubble rather than VS's Comment icon, an outline that disappears into the purple at that size: white
       for the mascot under it, a dark edge for a light tab around it. The transparent 16×16 frame pins its
       bounds (the stroke spans the width, not the height), so the glyph scales from the same box as the
       icon it sits on. -->
  <DrawingImage x:Key="ChatGlyphImage" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="White"
                         Geometry="M 3.5,1.75 H 12.5 A 2.75,2.75 0 0 1 15.25,4.5 V 8.5 A 2.75,2.75 0 0 1 12.5,11.25 H 8.25 L 4,14.75 V 11.25 H 3.5 A 2.75,2.75 0 0 1 0.75,8.5 V 4.5 A 2.75,2.75 0 0 1 3.5,1.75 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#1E1E1E" Thickness="1.5" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
